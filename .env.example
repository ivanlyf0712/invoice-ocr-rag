# ──────────────────── OCR Configuration ────────────────────
OCR_MODE=server                    # "server" | "cli"
OCR_SERVER_URL=http://127.0.0.1:8081/v1/chat/completions
OCR_SERVER_MODEL=Unlimited-OCR
OCR_SERVER_PROMPT=Please OCR the text in this image.
OCR_SERVER_TEMPERATURE=0.1
OCR_SERVER_MAX_TOKENS=2048
OCR_SERVER_REPEAT_PENALTY=1.5

# ── OCR: CLI mode paths (fallback) ──
LLAMA_CLI=~/llama.cpp/build/bin/llama-mtmd-cli
UOCR_MODEL=~/uocr/Unlimited-OCR-Q4_K_M.gguf
UOCR_MMPROJ=~/uocr/mmproj-Unlimited-OCR-F16.gguf

# ── Image preprocessing ──
MAX_LONG_EDGE=1024
JPEG_QUALITY=85

# ── Ollama ──
OLLAMA_URL=http://127.0.0.1:11434
TEXT_MODEL=qwen2.5:1.5b
EMBED_MODEL=mxbai-embed-large
RAG_MODEL=qwen2.5:1.5b

# ── llama-server (multi-page mode) ──
LLAMA_SERVER_URL=http://127.0.0.1:8081/v1/chat/completions

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=ocr
DB_PASSWORD=                   # required — no default value
DB_NAME=invoices

# ── Logging ──
LOG_LEVEL=INFO